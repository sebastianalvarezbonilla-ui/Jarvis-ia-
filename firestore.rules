rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 3 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isValidPublishedApp(data, appId) {
      return data.keys().hasAll([
          'slug',
          'title',
          'summary',
          'prompt',
          'htmlCode',
          'authorUid',
          'authorName',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'slug',
          'title',
          'summary',
          'prompt',
          'htmlCode',
          'status',
          'authorUid',
          'authorName',
          'createdAt',
          'updatedAt'
        ])
        && data.slug is string
        && data.slug == appId
        && data.slug.size() >= 3
        && data.slug.size() <= 80
        && data.slug.matches('^[a-z0-9\\-]+$')
        && data.title is string
        && data.title.size() >= 1
        && data.title.size() <= 120
        && data.summary is string
        && data.summary.size() >= 1
        && data.summary.size() <= 300
        && data.prompt is string
        && data.prompt.size() >= 1
        && data.prompt.size() <= 2000
        && data.htmlCode is string
        && data.htmlCode.size() >= 20
        && data.htmlCode.size() <= 400000
        && (!('status' in data) || (data.status is string && data.status in ['active', 'paused']))
        && data.authorUid is string
        && data.authorUid == request.auth.uid
        && data.authorUid.size() <= 128
        && data.authorName is string
        && data.authorName.size() >= 1
        && data.authorName.size() <= 80
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidConnectedApp(data, appId) {
      return data.keys().hasAll([
          'id',
          'name',
          'appType',
          'baseUrl',
          'healthPath',
          'defaultMethod',
          'description',
          'status',
          'lastCheckStatus',
          'lastHttpCode',
          'lastLatencyMs',
          'lastCheckedAtMs',
          'linkedPublishedSlug',
          'ownerUid',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'id',
          'name',
          'appType',
          'baseUrl',
          'healthPath',
          'defaultMethod',
          'description',
          'status',
          'lastCheckStatus',
          'lastHttpCode',
          'lastLatencyMs',
          'lastCheckedAtMs',
          'linkedPublishedSlug',
          'ownerUid',
          'createdAt',
          'updatedAt'
        ])
        && data.id is string
        && data.id == appId
        && data.id.size() >= 3
        && data.id.size() <= 80
        && data.id.matches('^[a-zA-Z0-9_\\-]+$')
        && data.name is string
        && data.name.size() >= 1
        && data.name.size() <= 100
        && data.appType is string
        && data.appType in ['openjarvis_app', 'web_app', 'api_rest', 'webhook']
        && data.baseUrl is string
        && data.baseUrl.size() >= 5
        && data.baseUrl.size() <= 500
        && data.baseUrl.matches('^(https?://|/p/).+')
        && data.healthPath is string
        && data.healthPath.size() <= 200
        && data.defaultMethod is string
        && data.defaultMethod in ['GET', 'POST', 'PUT', 'DELETE']
        && data.description is string
        && data.description.size() <= 300
        && data.status is string
        && data.status in ['active', 'paused']
        && data.lastCheckStatus is string
        && data.lastCheckStatus in ['unknown', 'online', 'error']
        && data.lastHttpCode is int
        && data.lastHttpCode >= 0
        && data.lastHttpCode <= 599
        && (data.lastLatencyMs is int || data.lastLatencyMs is float)
        && data.lastLatencyMs >= 0
        && data.lastLatencyMs <= 120000
        && (data.lastCheckedAtMs is int || data.lastCheckedAtMs is float)
        && data.lastCheckedAtMs >= 0
        && data.linkedPublishedSlug is string
        && data.linkedPublishedSlug.size() <= 80
        && data.ownerUid is string
        && data.ownerUid == request.auth.uid
        && data.ownerUid.size() <= 128
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidRouterProfile(data, profileId) {
      return data.keys().hasAll([
          'id',
          'name',
          'vendor',
          'hostUrl',
          'adminUsername',
          'authScheme',
          'connectionStatus',
          'lastHttpCode',
          'lastLatencyMs',
          'lastDiagnosticHealth',
          'lastDiagnosticSummary',
          'wifiName',
          'reachMode',
          'securityLevel',
          'priorityMode',
          'dnsProtection',
          'guestWifiEnabled',
          'guestWifiName',
          'autoOptimizeChannel',
          'ownerUid',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'id',
          'name',
          'vendor',
          'hostUrl',
          'adminUsername',
          'authScheme',
          'connectionStatus',
          'lastHttpCode',
          'lastLatencyMs',
          'lastDiagnosticHealth',
          'lastDiagnosticSummary',
          'wifiName',
          'reachMode',
          'securityLevel',
          'priorityMode',
          'dnsProtection',
          'guestWifiEnabled',
          'guestWifiName',
          'autoOptimizeChannel',
          'ownerUid',
          'createdAt',
          'updatedAt'
        ])
        && data.id is string
        && data.id == profileId
        && data.id.size() >= 3
        && data.id.size() <= 80
        && data.id.matches('^[a-zA-Z0-9_\\-]+$')
        && data.name is string
        && data.name.size() >= 1
        && data.name.size() <= 100
        && data.vendor is string
        && data.vendor in ['openwrt', 'mikrotik', 'asus', 'tplink', 'generic_rest', 'manual']
        && data.hostUrl is string
        && data.hostUrl.size() <= 300
        && data.adminUsername is string
        && data.adminUsername.size() >= 1
        && data.adminUsername.size() <= 64
        && data.authScheme is string
        && data.authScheme in ['basic', 'bearer', 'api_key_header', 'cookie_session']
        && data.connectionStatus is string
        && data.connectionStatus in ['unknown', 'connected', 'unreachable', 'snapshot_only']
        && data.lastHttpCode is int
        && data.lastHttpCode >= 0
        && data.lastHttpCode <= 599
        && (data.lastLatencyMs is int || data.lastLatencyMs is float)
        && data.lastLatencyMs >= 0
        && data.lastLatencyMs <= 120000
        && data.lastDiagnosticHealth is string
        && data.lastDiagnosticHealth in ['unknown', 'optimal', 'attention', 'critical']
        && data.lastDiagnosticSummary is string
        && data.lastDiagnosticSummary.size() <= 2000
        && data.wifiName is string
        && data.wifiName.size() >= 1
        && data.wifiName.size() <= 64
        && data.reachMode is string
        && data.reachMode in ['balanced', 'max_speed', 'max_range']
        && data.securityLevel is string
        && data.securityLevel in ['wpa2_standard', 'wpa3_max', 'strict_isolated']
        && data.priorityMode is string
        && data.priorityMode in ['general', 'video_calls', 'gaming_low_latency', 'streaming_4k']
        && data.dnsProtection is string
        && data.dnsProtection in ['isp_default', 'fast_private', 'family_safe']
        && data.guestWifiEnabled is bool
        && data.guestWifiName is string
        && data.guestWifiName.size() <= 64
        && data.autoOptimizeChannel is bool
        && data.ownerUid is string
        && data.ownerUid == request.auth.uid
        && data.ownerUid.size() <= 128
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    match /published_apps/{appId} {
      allow get: if isValidId(appId);
      allow list: if isSignedIn() && existing().authorUid == request.auth.uid;

      allow create: if isVerifiedUser()
        && isValidId(appId)
        && isValidPublishedApp(incoming(), appId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isVerifiedUser()
        && isValidId(appId)
        && isValidPublishedApp(incoming(), appId)
        && existing().authorUid == request.auth.uid
        && incoming().authorUid == existing().authorUid
        && incoming().slug == existing().slug
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'title',
          'summary',
          'prompt',
          'htmlCode',
          'status',
          'authorName',
          'updatedAt'
        ]);

      allow delete: if isVerifiedUser()
        && isValidId(appId)
        && existing().authorUid == request.auth.uid;
    }

    match /connected_apps/{appId} {
      allow get: if isVerifiedUser()
        && isValidId(appId)
        && existing().ownerUid == request.auth.uid;

      allow list: if isSignedIn() && existing().ownerUid == request.auth.uid;

      allow create: if isVerifiedUser()
        && isValidId(appId)
        && isValidConnectedApp(incoming(), appId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isVerifiedUser()
        && isValidId(appId)
        && isValidConnectedApp(incoming(), appId)
        && existing().ownerUid == request.auth.uid
        && incoming().ownerUid == existing().ownerUid
        && incoming().id == existing().id
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'name',
          'appType',
          'baseUrl',
          'healthPath',
          'defaultMethod',
          'description',
          'status',
          'lastCheckStatus',
          'lastHttpCode',
          'lastLatencyMs',
          'lastCheckedAtMs',
          'linkedPublishedSlug',
          'updatedAt'
        ]);

      allow delete: if isVerifiedUser()
        && isValidId(appId)
        && existing().ownerUid == request.auth.uid;
    }

    match /router_profiles/{profileId} {
      allow get: if isVerifiedUser()
        && isValidId(profileId)
        && existing().ownerUid == request.auth.uid;

      allow list: if isSignedIn() && existing().ownerUid == request.auth.uid;

      allow create: if isVerifiedUser()
        && isValidId(profileId)
        && isValidRouterProfile(incoming(), profileId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isVerifiedUser()
        && isValidId(profileId)
        && isValidRouterProfile(incoming(), profileId)
        && existing().ownerUid == request.auth.uid
        && incoming().ownerUid == existing().ownerUid
        && incoming().id == existing().id
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'name',
          'vendor',
          'hostUrl',
          'adminUsername',
          'authScheme',
          'connectionStatus',
          'lastHttpCode',
          'lastLatencyMs',
          'lastDiagnosticHealth',
          'lastDiagnosticSummary',
          'wifiName',
          'reachMode',
          'securityLevel',
          'priorityMode',
          'dnsProtection',
          'guestWifiEnabled',
          'guestWifiName',
          'autoOptimizeChannel',
          'updatedAt'
        ]);

      allow delete: if isVerifiedUser()
        && isValidId(profileId)
        && existing().ownerUid == request.auth.uid;
    }
  }
}
